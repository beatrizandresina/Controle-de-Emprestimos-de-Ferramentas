@model ControleFerramentas.Models.EmprestimoModel

@{
    ViewData["Title"] = "Novo Empréstimo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
    <h2>Registrar Novo Empréstimo</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="CadastrarEmprestimo" method="post">

            <div class="mb-3">
                <label class="form-label fw-bold">Colaborador / Pessoa:</label>
                <select asp-for="PessoaId" class="form-select select2" asp-items="ViewBag.Pessoas" required>
                    <option value="">-- Selecione a pessoa --</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Ferramenta:</label>
                <select asp-for="FerramentaId" class="form-select select2" asp-items="ViewBag.Ferramentas" required>
                    <option value="">-- Selecione a ferramenta --</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100">Registrar Empréstimo</button>
        </form>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.select2').select2({
                theme: 'bootstrap-5',
                placeholder: "-- Selecione para pesquisar --",
                width: '100%'
            });
        });
    </script>
}