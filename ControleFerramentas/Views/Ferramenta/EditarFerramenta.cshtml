@model ControleFerramentas.Models.FerramentaModel

@{
    ViewData["Title"] = "Editar Ferramenta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
    <h2>Editar Ferramenta</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="EditarFerramenta" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Nome da ferramenta:</label>
                <input asp-for="Nome" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Descrição da ferramenta:</label>
                <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Observação:</label>
                <textarea asp-for="Observacao" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Disponibilidade:</label>
                <select asp-for="Disponivel" class="form-select">
                    <option value="true">Sim</option>
                    <option value="false">Não</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100">Salvar Alterações</button>
        </form>
    </div>
</div>