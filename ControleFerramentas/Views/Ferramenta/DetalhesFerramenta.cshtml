@model ControleFerramentas.Models.FerramentaModel

@{
    ViewData["Title"] = "Detalhes da Ferramenta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
    <h2>Detalhes da Ferramenta</h2>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        <h4 class="mb-0">@Model.Nome</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-0">

            <dt class="col-sm-3 mb-3">Descrição:</dt>
            <dd class="col-sm-9 mb-3">@Model.Descricao</dd>

            <dt class="col-sm-3 mb-3">Data de Cadastro:</dt>
            <dd class="col-sm-9 mb-3">@Model.DataCadastro</dd>

            <dt class="col-sm-3 mb-3">Observação:</dt>
            <dd class="col-sm-9 mb-3">@(string.IsNullOrEmpty(Model.Observacao) ? "Nenhuma observação." : Model.Observacao)</dd>

            <dt class="col-sm-3 mb-3">Último Empréstimo:</dt>
            <dd class="col-sm-9 mb-3">@Model.DataUltimoEmprestimo</dd>

            <dt class="col-sm-3 mb-3">Última Devolução:</dt>
            <dd class="col-sm-9 mb-3">@Model.DataUltimaDevolucao</dd>

            <dt class="col-sm-3 mb-3">Status:</dt>
            <dd class="col-sm-9 mb-3">
                @if (Model.Disponivel)
                {
                    <span class="badge bg-success">Disponível</span>
                }
                else
                {
                    <span class="badge bg-danger">Indisponível</span>
                }
            </dd>
        </dl>
    </div>
</div>