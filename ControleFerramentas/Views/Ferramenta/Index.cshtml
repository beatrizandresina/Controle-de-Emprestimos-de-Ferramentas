@model IEnumerable<ControleFerramentas.Models.FerramentaModel>

@{
    ViewData["Title"] = "Lista de Ferramentas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a class="btn btn-secondary" asp-controller="Emprestimo" asp-action="Index">Voltar</a>
        <h2 class="m-0">Ferramentas Cadastradas</h2>
    </div>

    <a class="btn btn-primary" asp-controller="Ferramenta" asp-action="CadastrarFerramenta">
        + Cadastrar Nova
    </a>
</div>

<table class="table table-striped table-hover table-bordered border-light shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Disponível?</th>
            <th class="text-center">Ações</th>
        </tr>
    </thead>
    <tbody class="align-middle">
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Descricao</td>
                <td>
                    @if (item.Disponivel)
                    {
                        <span class="badge bg-success">Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Não</span>
                    }
                </td>
                <td class="text-center">
                    <a class="btn btn-sm btn-warning" asp-controller="Ferramenta" asp-action="EditarFerramenta" asp-route-id="@item.Id">Editar</a>
                    <a class="btn btn-sm btn-info text-white" asp-controller="Ferramenta" asp-action="DetalhesFerramenta" asp-route-id="@item.Id">Detalhes</a>
                    <a class="btn btn-sm btn-danger" asp-controller="Ferramenta" asp-action="ExcluirFerramenta" asp-route-id="@item.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>