@model ControleFerramentas.Models.PessoaModel

@{
    ViewData["Title"] = "Editar Pessoa";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
    <h2>Editar Pessoa</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="EditarPessoa" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Nome da pessoa:</label>
                <input asp-for="Nome" class="form-control" required/>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email:</label>
                <input asp-for="Email" class="form-control" required/>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Telefone:</label>
                <input asp-for="Telefone" class="form-control" required/>
            </div>

            <button type="submit" class="btn btn-primary w-100">Salvar Alterações</button>
        </form>
    </div>
</div>