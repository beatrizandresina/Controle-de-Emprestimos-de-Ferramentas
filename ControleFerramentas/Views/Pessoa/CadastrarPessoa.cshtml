@model ControleFerramentas.Models.PessoaModel

@{
    ViewData["Title"] = "Cadastrar Pessoa";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
    <h2>Cadastrar Nova Pessoa</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="CadastrarPessoa" method="post">

            <div class="mb-3">
                <label class="form-label fw-bold">Nome da pessoa:</label>
                <input asp-for="Nome" class="form-control" required placeholder="Digite o nome da pessoa..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email:</label>
                <input asp-for="Email" class="form-control" required placeholder="Digite o email da pessoa..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Telefone:</label>
                <input asp-for="Telefone" class="form-control" required placeholder="Digite o telefone da pessoa..." />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Senha de Acesso:</label>
                <input asp-for="Senha" type="password" class="form-control" required placeholder="Crie uma senha para este usuário..." />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Perfil:</label>
                <select asp-for="Perfil" class="form-select" required>
                    <option value="Admin">Admin</option>
                    <option value="Usuario">Usuario</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success w-100">Cadastrar Pessoa</button>
        </form>
    </div>
</div>